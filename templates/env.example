# SageCut asks the Clef decision model on Cloudflare Workers AI. Put these in a file named .env (never commit that file),
# or in ~/.sagecut/.env to use them in all your projects.
# Account ID: the 32-character ID in your dashboard address, dash.cloudflare.com/<account-id>/...
# API token: https://dash.cloudflare.com/profile/api-tokens → Create Token → use the "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLEF_MODEL=clef   # clef (default, $0.24/M input tokens), clef-flash ($0.038/M) or clef-omni ($0.15/M)
